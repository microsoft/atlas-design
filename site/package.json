{
	"name": "@microsoft/atlas-site",
	"version": "1.13.0",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^24.0.0",
		"npm": "^11.0.0"
	},
	"scripts": {
		"start": "wireit",
		"build": "wireit",
		"build-assets": "wireit",
		"toc": "wireit",
		"type-check": "tsc --noEmit",
		"prelint": "npm run type-check",
		"lint": "eslint . --ext .ts",
		"lint-fix": "eslint . --ext .ts --fix"
	},
	"wireit": {
		"toc": {
			"command": "node toc.js",
			"files": [
				"toc.js",
				"src/**/*.md"
			],
			"output": [
				"src/scaffold/toc.json",
				"dist/routes-for-class-prefixes.json"
			]
		},
		"build-assets": {
			"command": "node build-assets.js",
			"files": [
				"build-assets.js",
				"src/scaffold/**/*.scss",
				"src/scaffold/**/*.ts",
				"../css/src/**/*.scss"
			],
			"output": [
				"dist/scaffold/**"
			]
		},
		"build": {
			"command": "eleventy",
			"dependencies": [
				"toc",
				"build-assets"
			],
			"files": [
				"eleventy.config.js",
				"lib/**/*.js",
				"src/**/*.md",
				"src/scaffold/*.html"
			],
			"output": [
				"dist/**",
				"!dist/scaffold/**",
				"!dist/routes-for-class-prefixes.json"
			],
			"clean": "if-file-deleted"
		},
		"start": {
			"command": "node dev.js",
			"dependencies": [
				"toc"
			]
		}
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@microsoft/atlas-css": "6.15.0",
		"@microsoft/atlas-js": "^4.0.0",
		"@typescript-eslint/eslint-plugin": "^5.60.1",
		"@typescript-eslint/parser": "^5.60.1",
		"esbuild": "^0.28.1",
		"eslint": "^8.43.0",
		"eslint-config-prettier": "^8.8.0",
		"eslint-plugin-import": "^2.27.5",
		"front-matter": "^4.0.2",
		"highlight.js": "^11.11.1",
		"marked": "^5.1.2",
		"mustache": "^4.2.0",
		"sass": "^1.101.0",
		"typescript": "^5.1.5",
		"wireit": "0.14.9"
	}
}
